FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-numpy python3-scipy python3-pandas python3-matplotlib python3-psycopg2 && rm -rf /var/lib/apt/lists/*
COPY scripts/simulation ./scripts/simulation
ENV MPLCONFIGDIR=/tmp/matplotlib PYTHONUNBUFFERED=1
RUN python3 -m unittest discover -s scripts/simulation -p 'test_*.py'
CMD ["python3", "scripts/simulation/run.py"]
