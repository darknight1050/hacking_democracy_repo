FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-matplotlib && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY db ./db
COPY scripts ./scripts
ENV NEXT_TELEMETRY_DISABLED=1 MPLCONFIGDIR=/tmp/matplotlib
CMD ["node", "node_modules/tsx/dist/cli.mjs", "scripts/simulation/run.ts"]
